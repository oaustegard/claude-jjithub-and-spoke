# Copy to .env (gitignored) and fill in.

# Required: GitHub Personal Access Token (classic, scopes: repo, workflow, issues)
# Used to: (a) seed the jj identity from /user when JJ_USER_* are unset,
# (b) authenticate HTTPS clones and pushes via git's credential helper.
GH_TOKEN=ghp_your_token_here

# Optional: override the jj identity. If unset, boot.sh derives them from
# the GitHub user that owns $GH_TOKEN — .name (or .login) and .email (or
# <login>@users.noreply.github.com when GitHub returns null).
# JJ_USER_NAME="Your Name"
# JJ_USER_EMAIL="you@example.com"
